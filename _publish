#!/bin/bash

pandoc resume.md -o index.html -t html5 \
  -f markdown+smart \
  --standalone \
  --email-obfuscation=references \
  --data-dir=_pandoc \
  --include-in-header=_pandoc/header_styles.html \
  --include-before-body=_pandoc/header.html \
  --include-after-body=_pandoc/footer.html \
  --variable="pagetitle:Resume :: Jack Senechal"

# PDF: use whichever Chrome-family browser is installed. Fail loudly rather than leave a stale resume.pdf.
for browser in google-chrome-stable google-chrome chromium chromium-browser; do
  if command -v "$browser" >/dev/null 2>&1; then
    "$browser" --headless --disable-gpu --no-pdf-header-footer --print-to-pdf=resume.pdf index.html
    exit $?
  fi
done
echo "_publish: no Chrome/Chromium found; resume.pdf NOT regenerated" >&2
exit 1
